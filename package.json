{
  "name": "genspark-execution-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3000",
    "build": "rm -rf dist && wrangler deploy --dry-run --outdir dist && mv dist/index.js dist/_worker.js && rm -f dist/index.js.map dist/README.md",
    "deploy": "wrangler deploy",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.35.0"
  }
}