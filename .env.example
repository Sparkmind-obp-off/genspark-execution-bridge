APP_ENV=development
LOG_LEVEL=info

# Only populate after an official integration is verified.
GENSPARK_BASE_URL=
GENSPARK_API_KEY=
GENSPARK_MCP_URL=

GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=

# Set as Cloudflare Pages runtime secrets after operator rotates the Phase 4 key.
DAYTONA_API_KEY=
GATEWAY_OPERATOR_TOKEN=
# Separate owner login credential (32+ random characters), configured only as a Pages secret.
OWNER_LOGIN_CREDENTIAL=
# Never enable until Gate 0 and production gateway proof are verified.
GATEWAY_EXECUTION_ENABLED=
